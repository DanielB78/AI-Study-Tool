# Frontend (Vite) — copy to .env.local if needed. Never commit secrets.

# Backend base URL (chat + RAG)
# VITE_AI_API_BASE_URL=http://127.0.0.1:8000

# LLM execution: "manual" (default — no paid API) | "automatic"
# VITE_LLM_EXECUTION_MODE=manual

# RAG context budgets / spatial slider (optional)
# VITE_RAG_MAX_CONTEXT_ELEMENTS=12
# VITE_RAG_MAX_CONTEXT_CHARACTERS=12000
# VITE_RAG_SPATIAL_RADIUS_DEFAULT=300
# VITE_RAG_SPATIAL_RADIUS_MAX=2000
