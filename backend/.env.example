# Copy to .env and fill in values. Never commit .env.

# Required for AI requests when LLM_PROVIDER=openai (backend starts without it).
OPENAI_API_KEY=

# Model used by the OpenAI provider (change without touching the client).
OPENAI_MODEL=gpt-4o-mini

# Provider: "openai" (default) or "mock" for local UI testing without a paid key.
LLM_PROVIDER=openai

# PostgreSQL connection (Supabase Postgres compatible).
# Example local: postgresql+psycopg://studyboard:studyboard@127.0.0.1:5432/studyboard
DATABASE_URL=

# --- Embeddings (NO default model — must be set for semantic retrieval) ---
# Recommended local setup (EmbeddingGemma):
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=google/embeddinggemma-300m
EMBEDDING_DIMENSION=768
EMBEDDING_SIMILARITY=cosine
# Optional: cpu | cuda | mps (empty = auto)
# EMBEDDING_DEVICE=
# EMBEDDING_BATCH_SIZE=32

# Hugging Face token for gated models (EmbeddingGemma).
# Create at https://huggingface.co/settings/tokens after accepting the model terms.
HF_TOKEN=
# HUGGINGFACE_HUB_TOKEN=   # accepted as an alias for HF_TOKEN

# Alternate providers:
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_PROVIDER=deterministic
# EMBEDDING_MODEL=deterministic-hash-v1
# EMBEDDING_DIMENSION=64

# Retrieval — semantic only. Leave RAG_MIN_SIMILARITY unset/null until evaluated.
RAG_CHUNK_TOP_K=20
# RAG_MIN_SIMILARITY=
# RAG_SIMILARITY_METRIC=cosine

# AI interaction memory — recent window + semantic RAG over older turns.
# Leave INTERACTION_RAG_MIN_SIMILARITY unset/null until evaluated.
RECENT_INTERACTION_COUNT=3
INTERACTION_RAG_TOP_K=5
# INTERACTION_RAG_MIN_SIMILARITY=

# Query prompt processing
# QUERY_LONG_PROMPT_THRESHOLD_WORDS=200
# QUERY_TARGET_CHUNK_WORDS=125
# QUERY_CHUNK_OVERLAP_WORDS=20

# Optional RAG document chunking overrides
# RAG_SHORT_TEXT_THRESHOLD=100
# RAG_TARGET_CHUNK_WORDS=75
# RAG_CHUNK_OVERLAP_WORDS=15

# Optional overrides
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_TIMEOUT_SECONDS=60
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
