# Copy to .env and fill in values. Never commit .env.

# Required for AI requests when LLM_PROVIDER=openai (backend starts without it).
OPENAI_API_KEY=

# Model used by the OpenAI provider (change without touching the client).
OPENAI_MODEL=gpt-4o-mini

# Provider: "openai" (default) or "mock" for local UI testing without a paid key.
LLM_PROVIDER=openai

# PostgreSQL connection (Supabase Postgres compatible).
# Example local: postgresql+psycopg://studyboard:studyboard@127.0.0.1:5432/studyboard
DATABASE_URL=

# Optional RAG chunking overrides
# RAG_SHORT_TEXT_THRESHOLD=100
# RAG_TARGET_CHUNK_WORDS=75
# RAG_CHUNK_OVERLAP_WORDS=15

# Optional overrides
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_TIMEOUT_SECONDS=60
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
